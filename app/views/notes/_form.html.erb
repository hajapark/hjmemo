<%= form_with model: [topic, note], class: "space-y-6" do |form| %>
  <% if note.errors.any? %>
    <div class="rounded-xl bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold">
        메모를 저장할 수 없습니다.
      </p>

      <ul class="mt-2 list-inside list-disc">
        <% note.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :question, "질문", class: "mb-2 block text-sm font-medium text-slate-700" %>

    <%= form.text_area :question,
          required: true,
          rows: 4,
          placeholder: "복습할 때 먼저 볼 질문을 입력하세요.",
          class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
  </div>

  <div>
    <%= form.label :answer, "답변", class: "mb-2 block text-sm font-medium text-slate-700" %>

    <%= form.text_area :answer,
          required: true,
          rows: 8,
          placeholder: "질문의 답변을 입력하세요.",
          class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
  </div>

  <div>
    <%= form.label :answer_images, "답변 이미지", class: "mb-2 block text-sm font-medium text-slate-700" %>

    <%= form.file_field :answer_images,
          multiple: true,
          include_hidden: false,
          accept: "image/jpeg,image/png,image/webp",
          class: "block w-full text-sm text-slate-600" %>

    <p class="mt-2 text-sm text-slate-500">
      여러 이미지는 파일 선택 창에서 한 번에 선택하세요. JPEG, PNG, WebP 파일을 최대 5개까지 첨부할 수 있으며, 파일당 최대 5MB입니다.
    </p>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "취소",
          topic_notes_path(topic),
          class: "rounded-lg px-4 py-2 font-medium text-slate-600 hover:bg-slate-100" %>

    <%= form.submit(
          note.persisted? ? "메모 수정하기" : "메모 만들기",
          class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500"
        ) %>
  </div>
<% end %>
