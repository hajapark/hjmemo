<main class="min-h-screen bg-slate-50 px-6 py-12">
  <div class="mx-auto max-w-3xl">
    <%= link_to "← 홈",
          root_path,
          class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>

    <header class="mb-8 mt-6 flex flex-col items-stretch justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">
          주제
        </h1>

        <p class="mt-2 text-slate-600">
          <%= @topics.size %>개의 주제가 있습니다.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= link_to "복습 #{@due_note_count}개",
              review_path,
              class: "rounded-lg bg-white px-4 py-2 font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>

        <%= link_to "새 주제",
              new_topic_path,
              class: "rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
      </div>
    </header>

    <% if @topics.any? %>
      <div class="space-y-3">
        <% @topics.each do |topic| %>
          <article class="flex items-center justify-between gap-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">
              <%= link_to topic.name,
                    topic_notes_path(topic),
                    class: "hover:text-indigo-600" %>
            </h2>

            <div class="flex items-center gap-2">
              <%= link_to "수정",
                    edit_topic_path(topic),
                    class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" %>

              <%= button_to "삭제",
                    topic_path(topic),
                    method: :delete,
                    form: {
                      data: {
                        turbo_confirm: "정말 이 주제를 삭제하시겠습니까?"
                      }
                    },
                    class: "rounded-lg px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <section class="rounded-2xl bg-white p-10 text-center shadow-sm">
        <p class="text-slate-600">
          아직 만든 주제가 없습니다.
        </p>

        <%= link_to "첫 주제 만들기",
              new_topic_path,
              class: "mt-5 inline-block rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
      </section>
    <% end %>
  </div>
</main>
