<%= form_with model: topic, class: "space-y-6" do |form| %>
  <% if topic.errors.any? %>
    <div class="rounded-xl bg-red-50 p-4 text-left text-sm text-red-700">
      <p class="font-semibold">
        주제를 저장할 수 없습니다.
      </p>

      <ul class="mt-2 list-inside list-disc">
        <% topic.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name,
          "주제 이름",
          class: "mb-2 block text-sm font-medium text-slate-700" %>

    <%= form.text_field :name,
          autofocus: true,
          required: true,
          maxlength: 100,
          placeholder: "예: 영어 단어",
          class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none
          focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "취소",
          topics_path,
          class: "rounded-lg px-4 py-2 font-medium text-slate-600 hover:bg-slate-100" %>

    <%= form.submit "주제 만들기",
          class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white
          hover:bg-indigo-500" %>
  </div>
<% end %>
