<main class="grid min-h-screen place-items-center bg-slate-50 px-6 py-12">
  <div class="w-full max-w-md">
    <header class="mb-8 text-center">
      <%= link_to "HJMemo", root_path, class: "text-sm font-semibold text-indigo-600" %>
      <h1 class="mt-2 text-3xl font-bold text-slate-900">로그인</h1>
      <p class="mt-2 text-slate-600">학습 메모를 이어서 복습하세요.</p>
    </header>

    <section class="rounded-2xl bg-white p-8 shadow-sm">
      <%= form_for resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" } do |form| %>
        <div>
          <%= form.label :email, "이메일", class: "mb-2 block text-sm font-medium text-slate-700" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
        </div>

        <div>
          <%= form.label :password, "비밀번호", class: "mb-2 block text-sm font-medium text-slate-700" %>
          <%= form.password_field :password, autocomplete: "current-password", required: true, class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 text-sm text-slate-600">
            <%= form.check_box :remember_me, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
            로그인 상태 유지
          </label>
        <% end %>

        <%= form.submit "로그인", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-500" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </section>
  </div>
</main>
