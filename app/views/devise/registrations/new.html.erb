<main class="grid min-h-screen place-items-center bg-slate-50 px-6 py-12">
  <div class="w-full max-w-md">
    <header class="mb-8 text-center">
      <p class="text-sm font-semibold text-indigo-600">HJMemo</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-900">회원가입</h1>
      <p class="mt-2 text-slate-600">나만의 학습 메모를 시작하세요.</p>
    </header>

    <section class="rounded-2xl bg-white p-8 shadow-sm">
      <%= form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" } do |form| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= form.label :email, "이메일", class: "mb-2 block text-sm font-medium text-slate-700" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
        </div>

        <div>
          <%= form.label :password, "비밀번호", class: "mb-2 block text-sm font-medium text-slate-700" %>
          <%= form.password_field :password, autocomplete: "new-password", required: true, minlength: @minimum_password_length, class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
          <% if @minimum_password_length %>
            <p class="mt-2 text-sm text-slate-500">최소 <%= @minimum_password_length %>자</p>
          <% end %>
        </div>

        <div>
          <%= form.label :password_confirmation, "비밀번호 확인", class: "mb-2 block text-sm font-medium text-slate-700" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" %>
        </div>

        <%= form.submit "회원가입", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-500" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </section>
  </div>
</main>
