<main class="min-h-screen bg-slate-50 px-6 py-12">
  <div class="mx-auto max-w-3xl">
    <%= link_to "← 주제 목록",
          topics_path,
          class: "text-sm font-medium text-slate-600 hover:text-slate-900" %>

    <header class="mb-8 mt-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <h1 class="text-3xl font-bold text-slate-900">
        오늘의 복습
      </h1>

      <p class="rounded-full bg-indigo-100 px-4 py-2 text-sm font-semibold text-indigo-700">
        남은 복습 <%= @remaining_review_count %>개
      </p>
    </header>

    <% if @note %>
      <article class="rounded-2xl bg-white p-6 shadow-sm">
        <p class="text-sm font-semibold text-indigo-600">
          <%= @note.topic.name %>
        </p>

        <p class="mt-6 text-sm font-medium text-slate-500">
          질문
        </p>

        <h2 class="mt-2 break-words whitespace-pre-wrap text-xl font-semibold text-slate-900"><%= @note.question %></h2>

        <details class="mt-8 border-t border-slate-100 pt-6">
          <summary class="cursor-pointer font-semibold text-indigo-600">
            답 보기
          </summary>

          <div class="mt-5">
            <p class="break-words whitespace-pre-wrap text-slate-700"><%= @note.answer %></p>

            <% if @note.answer_images.attached? %>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <% @note.answer_images.each do |image| %>
                  <%= image_tag image,
                        alt: "답변 첨부 이미지",
                        class: "w-full rounded-xl border border-slate-200 object-contain" %>
                <% end %>
              </div>
            <% end %>

            <div class="mt-8 border-t border-slate-100 pt-6">
              <p class="mb-4 text-sm font-medium text-slate-600">
                얼마나 잘 기억했나요?
              </p>

              <div class="grid gap-3 sm:grid-cols-4">
                <%= button_to review_path,
                      method: :patch,
                      params: {
                        note_id: @note.id,
                        rating: "again"
                      },
                      class: "flex w-full flex-col rounded-lg bg-red-100 px-4 py-3 font-medium text-red-700 hover:bg-red-200" do %>
                  <span>다시</span>
                  <span class="mt-1 text-xs"><%= review_delay_label(@review_delays.fetch(:again)) %></span>
                <% end %>

                <%= button_to review_path,
                      method: :patch,
                      params: {
                        note_id: @note.id,
                        rating: "hard"
                      },
                      class: "flex w-full flex-col rounded-lg bg-amber-100 px-4 py-3 font-medium text-amber-700 hover:bg-amber-200" do %>
                  <span>어려움</span>
                  <span class="mt-1 text-xs"><%= review_delay_label(@review_delays.fetch(:hard)) %></span>
                <% end %>

                <%= button_to review_path,
                      method: :patch,
                      params: {
                        note_id: @note.id,
                        rating: "good"
                      },
                      class: "flex w-full flex-col rounded-lg bg-indigo-600 px-4 py-3 font-medium text-white hover:bg-indigo-500" do %>
                  <span>좋음</span>
                  <span class="mt-1 text-xs"><%= review_delay_label(@review_delays.fetch(:good)) %></span>
                <% end %>

                <%= button_to review_path,
                      method: :patch,
                      params: {
                        note_id: @note.id,
                        rating: "easy"
                      },
                      class: "flex w-full flex-col rounded-lg bg-emerald-100 px-4 py-3 font-medium text-emerald-700 hover:bg-emerald-200" do %>
                  <span>쉬움</span>
                  <span class="mt-1 text-xs"><%= review_delay_label(@review_delays.fetch(:easy)) %></span>
                <% end %>
              </div>
            </div>
          </div>
        </details>
      </article>
    <% else %>
      <section class="rounded-2xl bg-white p-10 text-center shadow-sm">
        <p class="text-lg font-semibold text-slate-900">
          지금 복습할 메모가 없습니다.
        </p>

        <% if @next_review_at %>
          <p class="mt-4 text-sm font-medium text-slate-500">
            가장 가까운 다음 복습
          </p>

          <time datetime="<%= @next_review_at.iso8601 %>"
                class="mt-1 block text-lg font-semibold text-indigo-600">
            <%= l @next_review_at,
                  format: "%Y년 %-m월 %-d일 %H:%M" %>
          </time>
        <% else %>
          <p class="mt-2 text-slate-600">
            메모를 만들면 바로 첫 복습을 시작할 수 있습니다.
          </p>

          <%= link_to "메모 만들러 가기",
                topics_path,
                class: "mt-5 inline-block rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
        <% end %>
      </section>
    <% end %>
  </div>
</main>
